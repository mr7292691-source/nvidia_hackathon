# --- Environment selector ---
LIFESHIELD_ENV=dev                     # dev | prod

# --- NVIDIA Build (dev-time NIM access) ---
# Get from https://build.nvidia.com -> your model -> "Get API Key" (starts with nvapi-)
NVIDIA_API_KEY=nvapi-changeme

# --- Switchyard (routing proxy in front of NIM) ---
SWITCHYARD_BASE_URL=http://localhost:8100/v1
SWITCHYARD_ROUTES_FILE=infra/switchyard/routes.dev.toml

# --- NeMo Relay (governance/observability) ---
NEMO_RELAY_ATOF_OUTPUT_DIR=./var/atof
NEMO_RELAY_ENABLE_GUARDRAILS=true

# --- OpenShell sandbox ---
OPENSHELL_SANDBOX_NAME=lifeshield-sandbox

# --- Curiosity B300 / prod NIM targets (used when LIFESHIELD_ENV=prod) ---
B300_NIM_VISION_URL=http://nim-vision.lifeshield.svc.cluster.local:8000/v1
B300_NIM_REASONING_URL=http://nim-reasoning.lifeshield.svc.cluster.local:8000/v1

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./var/lifeshield.db
APP_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
